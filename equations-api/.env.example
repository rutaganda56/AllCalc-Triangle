# Use the JDBC connection string and credentials from your Supabase database settings.
DATABASE_URL=jdbc:postgresql://your-database-host:5432/postgres?sslmode=require
DATABASE_USERNAME=your-database-username
DATABASE_PASSWORD=your-database-password

# Use an asymmetric ES256 or RS256 signing key in Supabase Auth.
# Keep the issuer and JWKS URL for the same project.
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Add the exact deployed frontend origin when deploying.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000
